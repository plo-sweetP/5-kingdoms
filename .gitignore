# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# Never commit signing keys / secrets
*.keystore
*.jks
*.p12
*.mobileprovision
.env

# IDE / editor
/.vs/
/.vscode/
/.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Build outputs
*.apk
*.aab
*.unitypackage
*.app
*.ipa
sysinfo.txt
crashlytics-build.properties

# Unity Package Manager / Asset Store caches
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local settings
.claude/settings.local.json

# Visual Studio solution files (regenerated by Unity)
*.slnx

# Tools outside Unity (our own project files are kept)
!/Tools/**/*.csproj
/Tools/**/bin/
/Tools/**/obj/
__pycache__/
